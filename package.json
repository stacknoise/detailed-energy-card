{
  "name": "detailed-energy-card",
  "version": "0.7.1",
  "description": "Home Assistant Lovelace card showing power flow from sources via floors and rooms to consumers",
  "type": "module",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "test:e2e": "playwright test --project=e2e",
    "screenshots": "playwright test --project=screenshots",
    "icon": "node scripts/render-icon.mjs"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@mdi/js": "^7.4.47",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
